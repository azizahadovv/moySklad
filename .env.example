# ============================================================
# Касса Назорати — созламалар намунаси.
# Серверда: `cp .env.example .env`, тўлдиринг, кейин `./deploy.sh`.
# ============================================================

# --- Telegram бот (@BotFather) ---
BOT_TOKEN=123456:ABC...
BOT_USERNAME=kassa_bot
# Биринчи SuperAdmin (Telegram ID — @userinfobot кўрсатади)
SUPERADMIN_TELEGRAM_ID=0
SUPERADMIN_NAME=SuperAdmin

# --- MoySklad JSON API 1.2 ---
MOYSKLAD_TOKEN=
# Ҳисоб юритиш бошланадиган сана (бу санадан олдинги ҳужжатлар ҳисобга олинмайди)
MOYSKLAD_LEDGER_START=2026-08-18

# --- Веб (Mini App + браузер панели) ---
# ИШЛАБ ЧИҚАРИШ: домен (А-ёзуви шу серверга кўрсатиши шарт). deploy.sh WEBAPP_URL'ни шундан ясайди.
DOMAIN=buxgalteriya.nsb.uz
ACME_EMAIL=admin@nsb.uz
# Автомат тўлдирилади: https://<DOMAIN>. Тест туннелида — trycloudflare манзили.
WEBAPP_URL=
# Компьютер/сервердаги ташқи порт (контейнер ичида доим 8080). 8080 банд бўлса ўзгартиринг.
HOST_PORT=8080
# Боғланиш манзили: серверда deploy.sh 127.0.0.1 қилиб қўяди (ташқарига фақат Caddy)
BIND_ADDR=0.0.0.0

# --- Маълумотлар базаси (docker-compose ичидаги postgres) ---
DB_URL=jdbc:postgresql://db:5432/kassa
DB_USER=data
DB_PASSWORD=CHANGE_ME

# --- Google Sheets (ихтиёрий: омбор нархлари, етказувчилар, даврлар) ---
GSHEET_ID=
GSHEET_SCRIPT_URL=
GSHEET_SECRET=
GOOGLE_SA_JSON=

# --- 📨 Bot xabarlari / карта қолдиқлari (TDLib Java, app ичида) ---
# ИХТИЁРИЙ: буларни бот ичидан ҳам киритиш мумкин (⚙️ 📨 → 🔑 API, 🤖 Манба бот).
# .env да берилса — бошланғич қиймат; бот ичидаги созлама устувор.
# api_id/api_hash — https://my.telegram.org (Login → API development tools).
TG_API_ID=
TG_API_HASH=
# Қайси ботнинг хабарлари ўқилсин (@ сиз):
TG_SOURCE_BOT=HUMOcardbot
