<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>uz.kassa</groupId>
    <artifactId>kassa-nazorati</artifactId>
    <version>0.1.0</version>
    <name>Kassa Nazorati Bot</name>
    <description>Kassa-buxgalteriya pul aylanmasini avtomatlashtiruvchi Telegram bot (TZ v1.0)</description>

    <properties>
        <java.version>17</java.version>
        <tdlight.version>3.5.4+td.1.8.66</tdlight.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Telegram Mini App uchun REST API + statik sahifa -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Telegram Bot API (long polling) -->
        <dependency>
            <groupId>org.telegram</groupId>
            <artifactId>telegrambots</artifactId>
            <version>6.9.7.1</version>
        </dependency>

        <!-- MoySklad javoblarini o'qish uchun (versiya Boot BOM dan) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Excel hisobot (mini app: 📊 Hisobot) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- telegrambots tortib keladigan jackson-module-jaxb-annotations uchun
             JDK 17+ da olib tashlangan javax.xml.bind API -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- 📨 To'liq Java TDLib mijozi (akkauntga kirib bot xabarlarini o'qish). Serverda: mvn -Ptdlib package.
             src/tdlib/java shu profilda kompilyatsiya bo'ladi; profilsiz oddiy build o'zgarmaydi. -->
        <profile>
            <id>tdlib</id>
            <!-- Repozitoriy FAQAT shu profilda — build tarmog'idan mvn.mchv.eu doim ochilavermaydi;
                 profilsiz oddiy build (spring-boot va h.k.) unga umuman murojaat qilmasin. -->
            <repositories>
                <repository>
                    <id>mchv</id>
                    <name>MCHV Apache Maven Packages</name>
                    <url>https://mvn.mchv.eu/repository/mchv/</url>
                </repository>
            </repositories>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>it.tdlight</groupId>
                        <artifactId>tdlight-java-bom</artifactId>
                        <version>${tdlight.version}</version>
                        <type>pom</type>
                        <scope>import</scope>
                    </dependency>
                </dependencies>
            </dependencyManagement>
            <dependencies>
                <dependency>
                    <groupId>it.tdlight</groupId>
                    <artifactId>tdlight-java</artifactId>
                </dependency>
                <dependency>
                    <groupId>it.tdlight</groupId>
                    <artifactId>tdlight-natives</artifactId>
                    <classifier>linux_amd64_gnu_ssl3</classifier>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>it.tdlight</groupId>
                    <artifactId>tdlight-natives</artifactId>
                    <classifier>linux_amd64_gnu_ssl1</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-tdlib-source</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources><source>src/tdlib/java</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
